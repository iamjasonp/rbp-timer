[Unit]
Description=RBP Productivity Timer
After=multi-user.target

[Service]
Type=simple
ExecStart=/opt/rbp-timer/.venv/bin/python -m rbp_timer.main
WorkingDirectory=/opt/rbp-timer
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
User=jason

[Install]
WantedBy=multi-user.target
